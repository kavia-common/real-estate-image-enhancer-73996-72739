# DatabaseService environment variables (example)
# IMPORTANT: Do not commit real secrets. The CI/CD orchestrator will provide actual values in .env.

# PostgreSQL connection for admin/migrations
DB_HOST=localhost
DB_PORT=5000
DB_NAME=myapp
DB_ADMIN_USER=app_admin
DB_ADMIN_PASSWORD=REPLACE_ME

# Application runtime binding (backend will use its own container .env)
APP_DB_USER=app_rw
APP_DB_PASSWORD=REPLACE_ME

# Optional auditing user
AUDIT_DB_USER=app_audit
AUDIT_DB_PASSWORD=REPLACE_ME

# Statement timeout for migrations (ms)
DB_STATEMENT_TIMEOUT=60000
